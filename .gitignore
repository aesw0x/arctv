# Build output — tizen-sdk writes the packaged app plus its own state next to the project.
tizen/Debug/
tizen/Release/
tizen/.tizen-rds/
tizen/.sign/

# Same for the webOS side: .build is the assembled app directory ares-package is pointed at.
webos/.build/
webos/Debug/

# And the Android TV client. local.properties is machine-only — it names where this desk keeps the SDK,
# which is a different path on every other one, so it must never reach the repo.
android-tv/.gradle/
android-tv/.kotlin/
android-tv/**/build/
android-tv/local.properties

# The mock phone streams a real film from here. Generated by tools/mock-server/make-media.ps1.
tools/mock-server/media/

# Diagnostics from perf.js, which is a temporary file.
tools/telemetry/
*.log

# Copies of Arc Player sources kept as a local reference while the phone half was being written.
reference/
handoff/

node_modules/
.DS_Store
Thumbs.db
